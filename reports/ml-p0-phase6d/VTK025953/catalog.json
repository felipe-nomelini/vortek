    "main_features": [
      {
        "text": "Alimentação via entrada USB permite recarregar a bateria de 1200mAh em computadores ou carregadores de aparelhos móveis.",
        "type": "key_value",
        "metadata": {}
      },
      {
        "text": "Ciclo de funcionamento programado com desligamento automático em 40 segundos previne o superaquecimento do motor.",
        "type": "key_value",
        "metadata": {}
      },
      {
        "text": "Capacidade total de 300ml permite o consumo direto da bebida no recipiente reduzindo a necessidade de lavagem de louça.",
        "type": "key_value",
        "metadata": {}
      },
      {
        "text": "Lâminas em inox permitem o processamento de gelo e frutas congeladas mantendo a consistência desejada nas misturas.",
        "type": "key_value",
        "metadata": {}
      },
      {
        "text": "Acompanha alça de transporte integrada que permite fixar o copo em bolsas ou mochilas durante o deslocamento diário.",
        "type": "key_value",
        "metadata": {}
      },
      {
        "text": "Funcionamento silencioso que possibilita a preparação de shakes ou sucos em ambientes de escritório ou locais públicos.",
        "type": "key_value",
        "metadata": {}
      }
    ],
